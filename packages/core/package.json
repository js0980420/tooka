{
  "name": "@tooka/core",
  "version": "1.0.0",
  "description": "Runtime and CLI for tooka — write slides in slides/, we handle the rest.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/vite/index.d.ts",
      "import": "./dist/vite/index.js"
    },
    "./locale": {
      "types": "./dist/locale/index.d.ts",
      "import": "./dist/locale/index.js"
    },
    "./env": {
      "types": "./env.d.ts"
    }
  },
  "bin": {
    "tooka": "./bin.js"
  },
  "files": [
    "bin.js",
    "dist",
    "env.d.ts",
    "src/app",
    "src/locale",
    "src/publishing",
    "src/shared",
    "skills",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "prepack": "pnpm build"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "slides",
    "presentation",
    "react",
    "vite"
  ],
  "license": "MIT",
  "author": {
    "name": "1weiho",
    "url": "https://github.com/1weiho"
  },
  "homepage": "https://tooka.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/1weiho/tooka.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/1weiho/tooka/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@babel/parser": "^7.29.2",
    "@babel/types": "^7.29.0",
    "@base-ui/react": "1.6.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/geist": "^5.2.8",
    "@tailwindcss/vite": "^4.3.2",
    "@vitejs/plugin-react": "^4.3.3",
    "chalk": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "commander": "^15.0.0",
    "emoji-picker-react": "^4.19.1",
    "fast-glob": "^3.3.2",
    "fflate": "^0.8.3",
    "html-to-image": "^1.11.13",
    "lucide-react": "^1.8.0",
    "next-themes": "^0.4.6",
    "react-image-crop": "^11.0.10",
    "react-router-dom": "^7.18.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.3.2",
    "tw-animate-css": "^1.4.0",
    "use-sync-external-store": "^1.6.0",
    "vite": "^5.4.10"
  },
  "peerDependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.19.17",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "shadcn": "^4.13.0",
    "tsdown": "^0.22.12",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  }
}
