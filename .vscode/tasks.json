{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "studio dev server",
      "type": "shell",
      "command": "[ -s \"$HOME/.nvm/nvm.sh\" ] && . \"$HOME/.nvm/nvm.sh\"; ss -tln | grep -q ':5173 ' || pnpm dev:studio",
      "isBackground": true,
      "runOptions": { "runOn": "folderOpen" },
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated"
      },
      "problemMatcher": {
        "pattern": {
          "regexp": ".*"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*",
          "endsPattern": "Local:.*517\\d"
        }
      }
    }
  ]
}
